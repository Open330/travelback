{
  "version": 8,
  "name": "Liberty",
  "sources": {
    "osm-standard": {
      "type": "raster",
      "tiles": [
        "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
      "maxzoom": 19
    }
  },
  "transition": {
    "duration": 0,
    "delay": 0
  },
  "center": [0, 20],
  "zoom": 2,
  "bearing": 0,
  "pitch": 0,
  "layers": [
    {
      "id": "osm-standard-tiles",
      "type": "raster",
      "source": "osm-standard",
      "minzoom": 0,
      "maxzoom": 19
    }
  ],
  "metadata": {
    "travelback:bundled": true,
    "travelback:description": "OpenStreetMap standard raster basemap."
  }
}
